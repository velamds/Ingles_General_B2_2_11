1}], "_data": [{"type": "question", "contents": [{"content": "engenn10le11ob08re3aud07", "type": "audio"}]}, {"content": "secondary_2", "type": "objective"}], "id": 6}], "_data": [{"type": "instructions", "contents": [{"content": "\nA basic <span class=\"tool-tip\" id=\"tip_3_0\">tenet</span> of Inuit mythology is the belief in other worlds that are inside the Earth , beneath the sea, and in the sky.\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 2", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Listening", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Listen to the audio. Move the images up and down <span class=\"sena-icon sena-icon-vertical-drag\"></span> according to the audio.\n<br/> You have 2 attempts to submit your answers.\n", "type": "text"}]}, {"content": [{"content": " A <span class=\"italic\">\"tenet\"</span> is a belief or idea that is very important to a group.", "tip_id": 0, "type": "text"}], "type": "tips"}], "id": 3, "stimuli_ids": []}, {"template_override": 1, "type": "GWR", "questions": [{"responses": [{"correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}, {"content": "secondary_3", "type": "objective"}], "id": 0}, {"responses": [{"correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}, {"content": "secondary_3", "type": "objective"}], "id": 1}], "_data": [{"type": "instructions", "contents": [{"content": "<span class=\"strong\">\nLegends are stories about the past. Now, it's your turn to write a short narrative.\n</span> <br/> \n<span class=\"italic\">Instructions:\n</span><br/><span class=\"bullet italic\">Write a short narrative on about a fictitious legend.\n</span><br/><span class=\"bullet italic\">Develop the narrative by describing a series of events over a period of time.\n</span> <br/><span class=\"bullet italic\">Include characters, setting, and time in history.\n</span><br/> <span class=\"bullet italic\">What happened first? Second? Include a plot.\n</span> <br/> <span class=\"bullet italic\">What do the characters learn at the end of the legend? For example: Does the legend explain the origins of certain animals (seals, walruses) , land formations like mountains or why people behave a certain way?\n</span> <br/> <span class=\"bullet italic\">Use linking words to connect ideas.\n</span> <br/> <span class=\"bullet italic\">Describe people and places using a wide range of vocabulary.\n</span> <br/> </br>", "type": "text"}, {"content": "When you have typed in ALL your answers, click the <span class  = \"strong\">Go to Writing Task</span> button. \n</span>\n\n", "type": "text"}, {"content": "<br/>My Narrative", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 3", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "instructions", "contents": [{"content": "<span class=\"strong\">Time to review your narrative.\n</span>", "type": "text"}, {"c